# Local development outside the Dev Container.
# Copy to .env (git-ignored), fill in, then load it in your shell:
#   set -a; . ./.env; set +a
# then run dbt from src/dbt (it picks up src/dbt/profiles.yml automatically).
# Never commit .env, private keys or passphrases.

DBT_TARGET=dev

SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=DBT_DEV_USER
SNOWFLAKE_ROLE=DBT_DEV_ROLE
SNOWFLAKE_DATABASE=ANALYTICS_DEV
SNOWFLAKE_WAREHOUSE=DBT_DEV_WH
SNOWFLAKE_PRIVATE_KEY_PATH=<absolute path to the dev key, outside this repository>
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>

# Optional: build into your own schemas (e.g. DEV_GUSTA_RAW) instead of the
# shared RAW/INTERMEDIATE/MART that the dev branch CI also writes to.
DBT_SCHEMA_PREFIX=
